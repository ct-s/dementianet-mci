# ---- Data (NEVER commit raw/processed audio or large files) ----
data/raw/*
data/interim/*
data/processed/*
data/external/*
!data/**/.gitkeep

# ---- Third-party Praat scripts (download separately; see praat/README.md) ----
praat/*
!praat/README.md
*.auto.TextGrid

# ---- Results: publish figures (PNG) and tables (CSV); raw media stays ignored ----
*.wav
*.mp3
*.m4a
*.flac

# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.pytest_cache/
.ruff_cache/

# ---- Environments ----
.venv/
venv/
env/
.conda/
*.conda

# ---- Notebooks ----
.ipynb_checkpoints/

# ---- Models / large binaries ----
*.pt
*.pth
*.pkl
*.joblib
models/*.bin

# ---- OS / editor ----
.DS_Store
.idea/
.vscode/
*.swp

# ---- Secrets ----
.env
*.key
